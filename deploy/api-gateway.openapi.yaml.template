openapi: 3.0.0
info:
  title: PharmaCheck Telegram Gateway
  version: 1.0.0
paths:
  /telegram:
    post:
      operationId: telegramWebhook
      x-yc-apigateway-integration:
        type: cloud_functions
        function_id: ${FUNCTION_ID}
        service_account_id: ${GATEWAY_SERVICE_ACCOUNT_ID}
        payload_format_version: "1.0"
      responses:
        "200":
          description: Telegram update acknowledged
        "400":
          description: Invalid update
        "401":
          description: Invalid Telegram secret header
        "502":
          description: Telegram API temporarily unavailable
        "503":
          description: Function is not ready
